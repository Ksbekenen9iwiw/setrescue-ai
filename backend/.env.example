# setup.bat generates this once. Never commit the actual .env file.
SETRESCUE_ENCRYPTION_KEY=
# The default database URL uses an absolute path under backend/data/.
SETRESCUE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SETRESCUE_DEMO_EMAIL=true
# Optional: only needed when demo email is disabled
SETRESCUE_RESEND_API_KEY=
